rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'fC9a8NWCx7XsnPb2iJKMa1UtZMr2' ||
        request.auth.token.admin == true
      );
    }

    function isUnder5MB() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024;
    }

    function isUnderDigitalLimit() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 200 * 1024 * 1024;
    }

    function isAllowedAttachmentType() {
      return request.resource != null && (
        request.resource.contentType == 'application/pdf' ||
        request.resource.contentType.matches('image/(jpeg|jpg|png|webp)')
      );
    }

    function isSafeDigitalContentType() {
      return request.resource != null
        && request.resource.contentType != null
        && !(
          request.resource.contentType.matches('(?i)^text/html.*') ||
          request.resource.contentType.matches('(?i)^application/xhtml\\+xml.*') ||
          request.resource.contentType.matches('(?i)^image/svg\\+xml.*') ||
          request.resource.contentType.matches('(?i)^(text|application)/(x-)?(java|ecma)script.*') ||
          request.resource.contentType.matches('(?i)^application/x-(msdownload|msdos-program|sh|csh|httpd-php).*')
        );
    }

    function isImageType() {
      return request.resource != null &&
        request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif)');
    }

    function hasAllowedDigitalExtension() {
      return request.resource.name.matches('.*\\.[a-zA-Z0-9]{1,15}$')
        && !request.resource.name.matches('(?i).*\\.(html|htm|xhtml|shtml|mhtml|mht|svg|svgz|js|mjs|cjs|jse|vbs|vbe|hta|php|phtml|phar|asp|aspx|jsp|jspx|cgi|exe|msi|msp|bat|cmd|com|scr|pif|cpl|dll|sys|drv|ps1|psm1|wsf|wsh|reg|lnk|inf|sh|bash|zsh)$');
    }

    // Owner-scoped application reply attachments (up to 5MB PDF/JPG/PNG/WEBP)
    match /application-replies/{userId}/{appId}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isSignedIn()
        && request.auth.uid == userId
        && isUnder5MB()
        && isAllowedAttachmentType();
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Service application initial uploads
    match /applications/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isUnder5MB() && isAllowedAttachmentType();
    }

    // User profile avatars
    match /avatars/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && isUnder5MB() && isImageType();
    }

    // Store order note attachments
    match /order-notes/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isUnder5MB() && isAllowedAttachmentType();
    }

    // Store custom print uploads
    match /custom-images/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && isUnder5MB() && isImageType();
    }

    // Product catalog images (Admin only)
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isUnder5MB() && isImageType();
    }

    // Digital product files (MP3, MP4, PDF, ZIP, docs, images, etc. up to 200MB) are admin-managed and customer-private.
    match /digital-products/{allPaths=**} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && isUnderDigitalLimit()
        && isSafeDigitalContentType()
        && hasAllowedDigitalExtension();
      allow delete: if isAdmin();
    }

    // Product review images
    match /reviews/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && isUnder5MB() && isImageType();
    }

    // Default deny catch-all
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
