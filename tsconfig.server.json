{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowJs": false,
    "outDir": ".",
    "rootDir": ".",
    "types": ["node"],
    "allowImportingTsExtensions": false,
    "sourceMap": false,
    "declaration": false
  },
  "include": [
    "server.ts",
    "worker.ts",
    "src/server/**/*.ts"
  ],
  "exclude": [
    "src/server/dataSync.ts",
    "src/server/**/*.test.ts"
  ]
}